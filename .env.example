# Load these through the shell/container/service manager; Go does not read .env itself.
T3Z_PORT=8080
T3Z_DB_PATH=./data/auth.db
T3Z_JWT_PRIVATE_KEY=./keys/private.pem
T3Z_JWT_PUBLIC_KEY=./keys/public.pem
T3Z_JWT_ISSUER=t3z.in
T3Z_JWT_AUDIENCE=t3z-api
T3Z_JWT_TTL_SECONDS=3600

# Existing Firebase project. The browser does not receive these credentials.
T3Z_FIREBASE_PROJECT_ID=
T3Z_FIREBASE_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=

# Production: exact HTTPS frontend origins, never https://* or arbitrary previews.
T3Z_FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
T3Z_COOKIE_SECURE=true
T3Z_COOKIE_SAME_SITE=lax
T3Z_SESSION_HOURS=24
# Only the actual Caddy/proxy network; the gateway must not be publicly bypassable.
T3Z_TRUSTED_PROXY_CIDRS=

WINDMILL_BASE_URL=http://127.0.0.1:8000
WINDMILL_WORKSPACE=main
WINDMILL_TOKEN=

# Only needed for module endpoints outside /apis/webhooks/{workflow_id}.
T3Z_MODULE_ORIGINS=
T3Z_MODULE_API_TOKEN=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
BILLING_WEBHOOK_SECRET=
DEMO_WEBHOOK_URL=
DEMO_WEBHOOK_SECRET=

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
GOOGLE_OAUTH_SUCCESS_REDIRECT=
GOOGLE_TOKEN_ENCRYPTION_KEY=
T3Z_INTEGRATION_JWT_AUDIENCE=t3z-integrations
T3Z_INTEGRATION_JWT_TTL_SECONDS=300